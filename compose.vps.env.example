# Copie este arquivo para .env na VPS e substitua o domínio pelo seu.
# Domínio DNS A/AAAA configurado para o IP público da VPS.
NEXFORGE_DOMAIN=
NEXFORGE_DOCKER_GID=
NEXFORGE_DB_NAME=nexforge
NEXFORGE_DB_USER=nexforge
NEXFORGE_SECRETS_PATH=/opt/nexforge/secrets
NEXFORGE_METRICS_RETENTION_DAYS=30
NEXFORGE_BACKUP_RETENTION_DAYS=30
NEXFORGE_POLL_MS=60000
NEXFORGE_PORT=4173
NEXFORGE_BACKUPS_PATH=/opt/nexforge/backups
NEXFORGE_HOST_METRICS_PATH=/opt/nexforge/host-metrics
TZ=America/Cuiaba

# Preencha somente se for configurar backup remoto compatível com S3.
NEXFORGE_RESTIC_REPOSITORY=
NEXFORGE_OFFSITE_REGION=us-east-1
NEXFORGE_RESTIC_KEEP_DAILY=30
NEXFORGE_RESTIC_KEEP_WEEKLY=8
NEXFORGE_RESTIC_KEEP_MONTHLY=12
