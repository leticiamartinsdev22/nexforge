# Copie para .env.local
# false/ausente = modo local de fallback. true = busca dados reais no agente (server/).
VITE_LIVE=true
# Vazio = usa o proxy do Vite (dev). Em produção, a URL pública do agente, ex.: https://api.seudominio.com
VITE_API_URL=
# Intervalo de atualização em ms
VITE_POLL_MS=60000
# Senha local de fallback para desenvolvimento. Só vale com VITE_LIVE ausente/false.
# VITE_DEMO_PASSWORD=admin2212
