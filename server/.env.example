# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
PANEL_PASSWORD=troque-por-uma-senha-forte
# String longa e aleatória (ex.: openssl rand -hex 32). Assina os tokens de login.
PANEL_SECRET=
# Use true quando servir o painel por HTTPS; deixe false somente para localhost HTTP.
COOKIE_SECURE=false
PORT=3001
# Só escuta localhost. Exponha via nginx/Cloudflare Tunnel com HTTPS.
HOST=127.0.0.1
# Origem(ns) do painel (front) permitidas no CORS, separadas por vírgula.
CORS_ORIGIN=http://localhost:5173
# Intervalo de coleta em ms (60000 = 60s)
POLL_MS=60000
# Atrás de proxy reverso? ponha true para o rate limit enxergar o IP real.
TRUST_PROXY=false
# Docker via socket-proxy (recomendado) em vez do socket direto:
# DOCKER_HOST=tcp://127.0.0.1:2375
# Docker Desktop no Windows (contexto desktop-linux):
# DOCKER_HOST=npipe:////./pipe/dockerDesktopLinuxEngine
