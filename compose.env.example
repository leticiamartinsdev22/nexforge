NEXFORGE_DB_NAME=nexforge
NEXFORGE_DB_USER=nexforge
NEXFORGE_SECRETS_PATH=C:/Users/YourUser/AppData/Local/NexForge/secrets
NEXFORGE_METRICS_RETENTION_DAYS=30
NEXFORGE_BACKUP_RETENTION_DAYS=30
NEXFORGE_POLL_MS=60000
NEXFORGE_PORT=4173
NEXFORGE_BACKUPS_PATH=./backups
NEXFORGE_HOST_METRICS_PATH=./host-metrics
TZ=America/Cuiaba

# Opcional: repositório Restic compatível com S3, por exemplo s3:https://s3.us-east-1.amazonaws.com/BUCKET/nexforge
NEXFORGE_RESTIC_REPOSITORY=
NEXFORGE_OFFSITE_REGION=us-east-1
NEXFORGE_RESTIC_KEEP_DAILY=30
NEXFORGE_RESTIC_KEEP_WEEKLY=8
NEXFORGE_RESTIC_KEEP_MONTHLY=12
